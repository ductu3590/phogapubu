{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/verify.py:*)",
      "Bash(python scripts/task.py:*)",
      "Bash(python scripts/tasks.py:*)",
      "Bash(python scripts/run.py:*)",
      "Bash(python scripts/logs.py:*)",
      "Bash(python scripts/ui_shot.py:*)",
      "Bash(python scripts/notify.py:*)",
      "Bash(python scripts/baseline.py show:*)",
      "Bash(python scripts/adopt_scan.py:*)",
      "PowerShell(python scripts/verify.py:*)",
      "PowerShell(python scripts/task.py:*)",
      "PowerShell(python scripts/tasks.py:*)",
      "PowerShell(python scripts/run.py:*)",
      "PowerShell(python scripts/logs.py:*)",
      "PowerShell(python scripts/ui_shot.py:*)",
      "PowerShell(python scripts/notify.py:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(supabase start:*)",
      "Bash(supabase status:*)",
      "Bash(supabase migration new:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase gen types:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)",
      "Bash(gh run:*)",
      "Bash(gh pr:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/harness_guard.py", "bash"], "timeout": 20 }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/harness_guard.py", "files"], "timeout": 20 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/scripts/notify.py", "--hook"], "timeout": 20 }
        ]
      }
    ]
  }
}
